{
  "port": 8081,
  "readTimeout": "300s",
  "writeTimeout": "300s",
  "logLevel": "info",
  "endpoints": [
    {
      "methods": ["GET"],
      "status": 200,
      "path": "/users",
      "jsonPath": "./users.json"
    },
    {
      "methods": ["GET"],
      "status": 200,
      "path": "/user/1",
      "json": {
        "id": 1,
        "name": "name",
        "address": "address"
      }
    },
    {
      "methods": ["GET"],
      "status": 200,
      "path": "/user/john",
      "json": {
        "id": 2,
        "name": "John Doe",
        "address": "1 John Doe Street, John Doe City."
      }
    },
    {
      "methods": ["GET"],
      "status": 200,
      "path": "/checklicense/MH1220260012345",
      "json": {
        "id": "mh1220260012345",
        "name": "Rahul Kumar",
        "address": "1 John Doe Street, John Doe City."
      }
    },
    {
      "methods": ["POST"],
      "path": "/error",
      "delay": 100,
      "status": 400,
      "json": {
        "message": "failed"
      }
    },
    {
      "methods": ["POST"],
      "path": "/api/*",
      "delay": 200,
      "proxy": "http://localhost:8090"
    }
  ]
}